{
  "name": "megs-cafe-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:db": "npx supabase test db supabase/tests/database",
    "coverage": "vitest run --coverage --coverage.include=supabase/functions/_shared/pricing.ts",
    "test:e2e": "playwright test",
    "test:a11y": "node tests/e2e/lighthouse-a11y.mjs",
    "test:maps-live": "node tests/e2e/maps-live-check.mjs"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "2.1.3",
    "@supabase/supabase-js": "^2.119.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^9.25.0",
    "@playwright/test": "1.64.1",
    "@types/google.maps": "3.67.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "lighthouse": "13.6.0",
    "sharp": "^0.35.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
